{% extends 'base.html.twig' %}

{% block title %}{{ 'home.meta_title'|trans }}{% endblock %}

{% block body %}
{% include '_header.html.twig' %}

<main>
    <section class="hero">
        <div class="hero-copy">
            <p class="eyebrow">{{ 'home.hero.eyebrow'|trans }}</p>
            <h1>{{ 'home.hero.title'|trans }}</h1>
            <p>{{ 'home.hero.text'|trans }}</p>
            <a class="button" href="{{ path('app_catalog') }}">{{ 'home.hero.cta'|trans }}</a>
        </div>
        <div class="hero-product" aria-label="Collection AURIM">
            <div class="jar jar-large"><span>AURIM</span><small>Radiance-Boosting<br>Body Scrub</small></div>
            <div class="jar jar-small"><span>AURIM</span><small>Radiant<br>Body Butter</small></div>
        </div>
    </section>

    <section class="trust-strip">
        <p><strong>{{ 'home.trust.stock.title'|trans }}</strong><span>{{ 'home.trust.stock.text'|trans }}</span></p>
        <p><strong>{{ 'home.trust.payment.title'|trans }}</strong><span>{{ 'home.trust.payment.text'|trans }}</span></p>
        <p><strong>{{ 'home.trust.formulas.title'|trans }}</strong><span>{{ 'home.trust.formulas.text'|trans }}</span></p>
        <p><strong>{{ 'home.trust.service.title'|trans }}</strong><span>{{ 'home.trust.service.text'|trans }}</span></p>
    </section>

    <section class="section products" id="boutique">
        <p class="eyebrow">{{ 'home.essentials.eyebrow'|trans }}</p>
        <h2>{{ 'home.essentials.title'|trans }}</h2>
        <div class="essentials-carousel" data-essentials-slider>
            <div class="essentials-controls" aria-label="{{ 'home.essentials.navigation'|trans }}">
                <button type="button" data-slider-previous aria-label="{{ 'home.essentials.previous'|trans }}">←</button>
                <span><b data-slider-current>01</b> / {{ '%02d'|format(products|length) }}</span>
                <button type="button" data-slider-next aria-label="{{ 'home.essentials.next'|trans }}">→</button>
            </div>
            <div class="product-grid essentials-track" data-slider-track>
                {% for product in products %}
                    <article class="product-card">
                        <a class="product-visual product-crop-{{ product.imagePosition }}" href="{{ path('app_product_show', {slug: product.slug}) }}">
                            <img src="{{ asset(product.imagePath) }}" alt="{{ product.localizedName(app.request.locale) }} AURIM" onerror="this.onerror=null;this.src='{{ asset('images/products/aurim-body-care-duo.jpg') }}'">
                            <span class="product-category">{{ product.category.localizedName(app.request.locale) }}</span>
                        </a>
                        <p class="tag">{{ product.localizedType(app.request.locale) }}</p>
                        <h3>{{ product.localizedName(app.request.locale) }}</h3>
                        <p>{{ product.localizedShortDescription(app.request.locale) }}</p>
                        <a href="{{ path('app_product_show', {slug: product.slug}) }}">{{ 'home.essentials.discover'|trans }} <span>→</span></a>
                    </article>
                {% else %}
                    <p>{{ 'home.essentials.empty'|trans }}</p>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="ritual" id="rituel">
        <div>
            <p class="eyebrow">{{ 'home.ritual.eyebrow'|trans }}</p>
            <h2>{{ 'home.ritual.title'|trans }}</h2>
        </div>
        <ol>
            <li><span>01</span><h3>{{ 'home.ritual.step1.title'|trans }}</h3><p>{{ 'home.ritual.step1.text'|trans }}</p></li>
            <li><span>02</span><h3>{{ 'home.ritual.step2.title'|trans }}</h3><p>{{ 'home.ritual.step2.text'|trans }}</p></li>
            <li><span>03</span><h3>{{ 'home.ritual.step3.title'|trans }}</h3><p>{{ 'home.ritual.step3.text'|trans }}</p></li>
        </ol>
    </section>

    <section class="ingredients section" id="ingredients">
        <p class="eyebrow">{{ 'home.ingredients.eyebrow'|trans }}</p>
        <h2>{{ 'home.ingredients.title'|trans }}</h2>
        <div class="ingredient-grid">
            <article><span>01</span><h3>{{ 'home.ingredients.turmeric.title'|trans }}</h3><p>{{ 'home.ingredients.turmeric.text'|trans }}</p></article>
            <article><span>02</span><h3>{{ 'home.ingredients.vitamin_c.title'|trans }}</h3><p>{{ 'home.ingredients.vitamin_c.text'|trans }}</p></article>
            <article><span>03</span><h3>{{ 'home.ingredients.niacinamide.title'|trans }}</h3><p>{{ 'home.ingredients.niacinamide.text'|trans }}</p></article>
        </div>
    </section>

    <section class="story" id="histoire">
        <div class="story-art"><span>A</span></div>
        <div class="story-copy">
            <p class="eyebrow">Glowing by Rima</p>
            <h2>{{ 'home.story.title'|trans }}</h2>
            <p>{{ 'home.story.text'|trans }}</p>
            <a class="text-link" href="{{ path('app_legal_notice') }}">{{ 'home.story.cta'|trans }} →</a>
        </div>
    </section>
</main>

{% include '_footer.html.twig' %}
{% endblock %}
