{% extends 'base.html.twig' %}

{% block title %}{{ 'cart.meta_title'|trans }}{% endblock %}

{% block body %}
{% include '_header.html.twig' %}
<main class="cart-page">
    <div class="cart-heading"><p class="eyebrow">{{ 'cart.eyebrow'|trans }}</p><h1>{{ 'cart.title'|trans }}</h1></div>
    {% for message in app.flashes('success') %}<div class="cart-flash">{{ message }}</div>{% endfor %}
    {% for message in app.flashes('cart_error') %}<div class="checkout-errors" role="alert">{{ message|trans }}</div>{% endfor %}
    {% if lines is empty %}
        <section class="cart-empty"><h2>{{ 'cart.empty.title'|trans }}</h2><p>{{ 'cart.empty.text'|trans }}</p><a class="button" href="{{ path('app_catalog') }}">{{ 'cart.empty.cta'|trans }}</a></section>
    {% else %}
        <div class="cart-layout">
            <section class="cart-lines">
                {% for line in lines %}
                    <article class="cart-line">
                        <a class="cart-image product-crop-{{ line.product.imagePosition }}" href="{{ path('app_product_show', {slug: line.product.slug}) }}"><img src="{{ asset(line.product.imagePath) }}" alt="{{ line.product.localizedName(app.request.locale) }}" onerror="this.onerror=null;this.src='{{ asset('images/products/aurim-body-care-duo.jpg') }}'"></a>
                        <div class="cart-product"><p class="tag">{{ line.product.localizedType(app.request.locale) }}</p><h2>{{ line.product.localizedName(app.request.locale) }}</h2><p>{{ line.product.size }}</p>
                            {% if not line.stockSufficient %}<div class="product-error">{{ (line.availableQuantity == 0 ? 'cart.stock.none' : 'cart.stock.limited')|trans({'%count%': line.availableQuantity}) }}</div>{% endif %}
                            <form action="{{ path('app_cart_update', {id: line.product.id}) }}" method="post"><input type="hidden" name="_token" value="{{ csrf_token('cart-update-' ~ line.product.id) }}"><label>{{ 'product.quantity'|trans }} <input type="number" min="0" max="20" name="quantity" value="{{ line.quantity }}"></label><button type="submit">{{ 'cart.update'|trans }}</button></form>
                        </div>
                        <div class="cart-line-price">
                            {% if line.lineTotal is not null and store_context.selectedMarket %}<strong>{{ price_formatter.format(line.lineTotal, store_context.selectedMarket.currencyCode) }}</strong>{% else %}<strong>{{ 'cart.price_confirm'|trans }}</strong>{% endif %}
                            <form action="{{ path('app_cart_remove', {id: line.product.id}) }}" method="post"><input type="hidden" name="_token" value="{{ csrf_token('cart-remove-' ~ line.product.id) }}"><button type="submit">{{ 'cart.remove'|trans }}</button></form>
                        </div>
                    </article>
                {% endfor %}
            </section>
            <aside class="cart-summary"><p class="eyebrow">{{ 'cart.summary'|trans }}</p><div><span>{{ 'cart.subtotal'|trans }}</span><strong>{% if total is not null and store_context.selectedMarket %}{{ price_formatter.format(total, store_context.selectedMarket.currencyCode) }}{% else %}{{ 'cart.to_confirm'|trans }}{% endif %}</strong></div><p>{{ 'cart.shipping_note'|trans }}</p>{% if not store_context.selectedMarket %}<div class="cart-warning">{{ 'cart.warning.country'|trans }}</div>{% elseif total is null %}<div class="cart-warning">{{ 'cart.warning.price'|trans }}</div>{% elseif not hasSufficientStock %}<div class="cart-warning">{{ 'cart.warning.stock'|trans }}</div>{% endif %}{% if store_context.selectedMarket and total is not null and hasSufficientStock %}<a class="button" href="{{ path('app_checkout') }}">{{ 'cart.checkout'|trans }}</a>{% else %}<button class="button button-disabled" disabled>{{ 'cart.checkout'|trans }}</button>{% endif %}</aside>
        </div>
    {% endif %}
</main>
{% include '_footer.html.twig' %}
{% endblock %}
