{% extends 'base.html.twig' %}

{% block title %}{{ product.localizedName(app.request.locale) }} — AURIM{% endblock %}

{% block body %}
{% include '_header.html.twig' %}
{% set offerPrice = product_offer.price(product) %}
{% set availableQuantity = product_offer.availableQuantity(product) %}
{% set purchasable = product_offer.purchasable(product) %}

<main class="pdp-page">
    <nav class="pdp-breadcrumbs" aria-label="{{ 'product.breadcrumb'|trans }}">
        <a href="{{ path('app_home') }}">{{ 'product.home'|trans }}</a><span>→</span>
        <a href="{{ path('app_catalog') }}">{{ 'nav.shop'|trans }}</a><span>→</span>
        <a href="{{ path('app_catalog', {categorie: product.category.slug}) }}">{{ product.category.localizedName(app.request.locale) }}</a>
    </nav>

    <section class="pdp-layout">
        <div class="pdp-gallery" data-product-gallery>
            <div class="pdp-thumbnails" aria-label="Vues du produit">
                <button class="active" type="button" data-gallery-view="natural" aria-label="{{ 'product.main_view'|trans }}">
                    <img src="{{ asset(product.imagePath) }}" alt="" onerror="this.onerror=null;this.src='{{ asset('images/products/aurim-body-care-duo.jpg') }}'">
                </button>
                <button type="button" data-gallery-view="detail" aria-label="{{ 'product.detail_view'|trans }}">
                    <img src="{{ asset(product.imagePath) }}" alt="" onerror="this.onerror=null;this.src='{{ asset('images/products/aurim-body-care-duo.jpg') }}'">
                </button>
            </div>
            <div class="pdp-main-image product-crop-{{ product.imagePosition }}">
                <img data-gallery-main src="{{ asset(product.imagePath) }}" alt="{{ product.localizedName(app.request.locale) }} AURIM" onerror="this.onerror=null;this.src='{{ asset('images/products/aurim-body-care-duo.jpg') }}'">
                <span class="pdp-image-label">AURIM · Glowing by Rima</span>
            </div>
        </div>

        <div class="pdp-info">
            <p class="eyebrow">{{ product.category.localizedName(app.request.locale) }} · {{ product.localizedType(app.request.locale) }}</p>
            <h1>{{ product.localizedName(app.request.locale) }}</h1>
            <p class="pdp-size">{{ product.size }} · {{ 'product.reference'|trans }} {{ product.sku }}</p>
            <p class="pdp-lead">{{ product.localizedShortDescription(app.request.locale) }}</p>

            <ul class="pdp-benefits" aria-label="Bénéfices du produit">
                {% for benefit in product.localizedBenefits(app.request.locale) %}<li>{{ benefit }}</li>{% endfor %}
            </ul>

            <div class="pdp-price">
                {% if offerPrice and store_context.selectedMarket %}
                    {{ price_formatter.format(offerPrice.amountMinor, store_context.selectedMarket.currencyCode) }}
                {% elseif store_context.selectedMarket %}
                    {{ 'product.price_soon'|trans }}
                {% else %}
                    {{ 'product.select_country_price'|trans }}
                {% endif %}
            </div>

            {% for message in app.flashes('cart_error') %}<div class="product-error">{{ message|trans }}</div>{% endfor %}
            <div class="pdp-availability">
                <span class="{{ availableQuantity > 0 ? 'available' : '' }}"></span>
                {% if not store_context.selectedMarket %}
                    {{ 'product.select_country_stock'|trans }}
                {% elseif availableQuantity > 0 %}
                    {{ 'product.stock_available'|trans({'%count%': availableQuantity, '%suffix%': availableQuantity > 1 ? 's' : ''}) }}
                {% else %}
                    {{ 'product.unavailable'|trans }}
                {% endif %}
            </div>

            <form class="pdp-buy" action="{{ path('app_cart_add', {id: product.id}) }}" method="post" data-quantity-picker>
                <input type="hidden" name="_token" value="{{ csrf_token('cart-add-' ~ product.id) }}">
                <div class="pdp-quantity" aria-label="{{ 'product.quantity'|trans }}">
                    <button type="button" data-quantity-minus aria-label="{{ 'product.quantity_decrease'|trans }}">−</button>
                    <input type="number" name="quantity" value="1" min="1" max="{{ availableQuantity > 20 ? 20 : (availableQuantity > 0 ? availableQuantity : 1) }}" aria-label="{{ 'product.quantity'|trans }}">
                    <button type="button" data-quantity-plus aria-label="{{ 'product.quantity_increase'|trans }}">+</button>
                </div>
                <button class="button {{ not purchasable ? 'button-disabled' : '' }}" type="submit" {{ not purchasable ? 'disabled' : '' }}>{{ 'product.add_to_cart'|trans }} <span>→</span></button>
            </form>

            <div class="pdp-reassurance">
                <div><span>01</span><p><strong>{{ 'product.reassurance.stock.title'|trans }}</strong><small>{{ 'product.reassurance.stock.text'|trans }}</small></p></div>
                <div><span>02</span><p><strong>{{ 'product.reassurance.delivery.title'|trans }}</strong><small>{{ 'product.reassurance.delivery.text'|trans }}</small></p></div>
                <div><span>03</span><p><strong>{{ 'product.reassurance.payment.title'|trans }}</strong><small>{{ 'product.reassurance.payment.text'|trans }}</small></p></div>
            </div>

            <div class="pdp-accordions">
                <details open>
                    <summary>{{ 'product.description'|trans }} <span>+</span></summary>
                    <div class="pdp-accordion-content"><p>{{ product.localizedDescription(app.request.locale) }}</p></div>
                </details>
                <details>
                    <summary>{{ 'product.benefits'|trans }} <span>+</span></summary>
                    <div class="pdp-accordion-content"><ul>{% for benefit in product.localizedBenefits(app.request.locale) %}<li>{{ benefit }}</li>{% endfor %}</ul></div>
                </details>
                <details>
                    <summary>{{ 'product.ingredients'|trans }} <span>+</span></summary>
                    <div class="pdp-accordion-content pdp-actives">
                        {% for ingredient in product.localizedIngredients(app.request.locale) %}<article><b>0{{ loop.index }}</b><div><strong>{{ ingredient.name }}</strong><p>{{ ingredient.text }}</p></div></article>{% endfor %}
                    </div>
                </details>
                <details>
                    <summary>{{ 'product.usage'|trans }} <span>+</span></summary>
                    <div class="pdp-accordion-content"><p>{{ product.localizedUsageInstructions(app.request.locale) }}</p></div>
                </details>
            </div>
        </div>
    </section>

    <section class="pdp-signature">
        <div class="pdp-signature-mark">A</div>
        <div>
            <p class="eyebrow">{{ 'product.signature.eyebrow'|trans }}</p>
            <h2>{{ 'product.signature.title'|trans }}</h2>
            <p>{{ 'product.signature.text'|trans }}</p>
            <a class="text-link" href="{{ path('app_catalog') }}">{{ 'product.signature.cta'|trans }} →</a>
        </div>
    </section>
</main>
{% include '_footer.html.twig' %}
{% endblock %}
