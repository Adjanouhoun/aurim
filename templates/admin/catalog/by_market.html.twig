{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Prix et stocks par pays{% endblock %}

{% block main %}
    <style>
        .catalog-market-tabs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem;margin-bottom:1.5rem}.catalog-market-tab{display:flex;justify-content:space-between;align-items:center;padding:1.1rem 1.2rem;border:1px solid #ded7cd;border-radius:12px;background:#fff;color:#4f463d;text-decoration:none}.catalog-market-tab:hover{border-color:#b88a43;color:#6f512b}.catalog-market-tab.active{border-color:#8b6637;background:#2d261f;color:#fff}.catalog-market-tab small{display:block;margin-top:.2rem;color:inherit;opacity:.7}.catalog-market-tab span{width:10px;height:10px;border-radius:50%;background:#b04f43}.catalog-market-tab span.on{background:#6d915d}.catalog-market-summary{display:grid;grid-template-columns:2fr 1fr 1fr;gap:1rem;margin-bottom:1.5rem}.catalog-market-summary article{padding:1.2rem;border:1px solid #e2dbd2;border-radius:12px;background:#fff}.catalog-market-summary strong{display:block;color:#8b6637;font-size:1.45rem}.catalog-market-summary span{color:#756b62;font-size:.78rem}.catalog-market-notice{padding:1rem 1.2rem;margin-bottom:1.2rem;border-left:4px solid #c99c58;background:#faf4ea}.catalog-market-form{overflow:auto;border:1px solid #e2dbd2;border-radius:12px;background:#fff}.catalog-market-table{width:100%;margin:0;border-collapse:collapse}.catalog-market-table th{padding:.9rem;background:#f8f4ee;color:#766b60;font-size:.68rem;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap}.catalog-market-table td{padding:.85rem;border-top:1px solid #ece6de;vertical-align:middle}.catalog-market-product{display:flex;align-items:center;gap:.8rem;min-width:260px}.catalog-market-product img{width:52px;height:52px;border-radius:8px;object-fit:cover;background:#f0e9df}.catalog-market-product strong,.catalog-market-product small{display:block}.catalog-market-product small{color:#837a71}.catalog-market-input{width:125px;padding:.65rem .7rem;border:1px solid #d8cec2;border-radius:7px;background:#fff}.catalog-market-input.stock{width:92px}.catalog-market-reserved{color:#786e64;white-space:nowrap}.catalog-market-publish{display:flex;justify-content:center}.catalog-market-publish input{width:19px;height:19px;accent-color:#8b6637}.catalog-market-actions{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1.1rem 1.2rem;border-top:1px solid #e2dbd2;background:#fbf8f3}.catalog-market-actions p{margin:0;color:#756b62;font-size:.78rem}.catalog-market-actions button{border:0;border-radius:7px;background:#8b6637;color:#fff;padding:.8rem 1.2rem;font-weight:700;cursor:pointer}.catalog-market-empty{padding:3rem;text-align:center;color:#756b62}@media(max-width:900px){.catalog-market-tabs{grid-template-columns:1fr 1fr}.catalog-market-summary{grid-template-columns:1fr}.catalog-market-actions{align-items:flex-start;flex-direction:column}}@media(max-width:560px){.catalog-market-tabs{grid-template-columns:1fr}}
    </style>

    {% for message in app.flashes('success') %}<div class="alert alert-success">{{ message }}</div>{% endfor %}
    {% for message in app.flashes('danger') %}<div class="alert alert-danger">{{ message }}</div>{% endfor %}

    <nav class="catalog-market-tabs" aria-label="Choisir le marché">
        {% for market in markets %}
            <a class="catalog-market-tab {{ selectedMarket and selectedMarket.id == market.id ? 'active' : '' }}" href="{{ path('admin_catalog_by_market', {pays: market.countryCode}) }}">
                <div><strong>{{ market.name }}</strong><small>{{ market.currencyCode }}</small></div>
                <span class="{{ market.active and market.warehouse and market.warehouse.active ? 'on' : '' }}" title="{{ market.active ? 'Marché actif' : 'Marché inactif' }}"></span>
            </a>
        {% endfor %}
    </nav>

    {% if selectedMarket %}
        <section class="catalog-market-summary">
            <article><strong>{{ warehouse ? warehouse.name : 'Aucun entrepôt' }}</strong><span>Entrepôt associé à {{ selectedMarket.name }}</span></article>
            <article><strong>{{ publishedCount }}/{{ rows|length }}</strong><span>Prix publiés</span></article>
            <article><strong>{{ availableCount }}/{{ rows|length }}</strong><span>Produits disponibles</span></article>
        </section>

        {% if not selectedMarket.active or not warehouse or not warehouse.active %}
            <p class="catalog-market-notice">Ce marché ou son entrepôt est inactif. Les clients ne pourront pas sélectionner ce pays tant qu’ils ne seront pas réactivés.</p>
        {% endif %}

        {% if warehouse %}
            <form method="post" class="catalog-market-form">
                <input type="hidden" name="_token" value="{{ csrf_token('catalog-market-' ~ selectedMarket.id) }}">
                <table class="catalog-market-table">
                    <thead>
                        <tr><th>Produit</th><th>Prix ({{ selectedMarket.currencyCode }})</th><th>Publier</th><th>Stock physique</th><th>Réservé</th><th>Seuil d’alerte</th></tr>
                    </thead>
                    <tbody>
                    {% for row in rows %}
                        <tr>
                            <td>
                                <div class="catalog-market-product">
                                    <img src="{{ asset(row.product.imagePath) }}" alt="">
                                    <div><strong>{{ row.product.name }}</strong><small>{{ row.product.sku }} · {{ row.product.size }}</small></div>
                                </div>
                            </td>
                            <td><input class="catalog-market-input" type="number" min="0" step="{{ currencyDecimals ? '0.01' : '1' }}" name="prices[{{ row.product.id }}]" value="{{ row.price and row.price.amountMinor is not null ? (row.price.amountMinor / currencyDivisor)|number_format(currencyDecimals, '.', '') : '' }}" placeholder="À définir"></td>
                            <td><label class="catalog-market-publish"><input type="checkbox" name="published[{{ row.product.id }}]" value="1" {{ row.price and row.price.published ? 'checked' : '' }} aria-label="Publier le prix de {{ row.product.name }}"></label></td>
                            <td><input class="catalog-market-input stock" type="number" min="0" step="1" name="stocks[{{ row.product.id }}]" value="{{ row.inventory ? row.inventory.quantityOnHand : 0 }}"></td>
                            <td class="catalog-market-reserved">{{ row.inventory ? row.inventory.quantityReserved : 0 }}</td>
                            <td><input class="catalog-market-input stock" type="number" min="0" step="1" name="thresholds[{{ row.product.id }}]" value="{{ row.inventory ? row.inventory.lowStockThreshold : 5 }}"></td>
                        </tr>
                    {% else %}
                        <tr><td class="catalog-market-empty" colspan="6">Aucun produit publié dans le catalogue.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
                <div class="catalog-market-actions">
                    <p>Le stock réservé est calculé automatiquement à partir des commandes et ne peut pas être modifié ici.</p>
                    <button type="submit">Enregistrer {{ selectedMarket.name }}</button>
                </div>
            </form>
        {% endif %}
    {% endif %}
{% endblock %}
