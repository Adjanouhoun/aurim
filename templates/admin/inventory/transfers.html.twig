{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Transferts de stock{% endblock %}

{% block main %}
    <style>
        .transfer-tabs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem;margin-bottom:1.5rem}.transfer-tab{display:flex;justify-content:space-between;align-items:center;padding:1.1rem 1.2rem;border:1px solid #ded7cd;border-radius:12px;background:#fff;color:#4f463d;text-decoration:none}.transfer-tab:hover{border-color:#b88a43;color:#6f512b}.transfer-tab.active{border-color:#8b6637;background:#2d261f;color:#fff}.transfer-tab small{display:block;margin-top:.2rem;color:inherit;opacity:.7}.transfer-tab span{font-size:.72rem}.transfer-flow{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1rem;padding:1.2rem;margin-bottom:1.3rem;border:1px solid #e2dbd2;border-radius:12px;background:#fff}.transfer-flow article{padding:.8rem 1rem;border-radius:9px;background:#f8f4ee}.transfer-flow strong,.transfer-flow small{display:block}.transfer-flow small{color:#756b62}.transfer-flow i{color:#9a733f;font-size:1.4rem}.transfer-notice{padding:1rem 1.2rem;margin-bottom:1rem;border-left:4px solid #c99c58;background:#faf4ea}.transfer-notice.danger{border-color:#a24136;background:#f8e9e6;color:#873c33}.transfer-create{margin-bottom:1.5rem;border:1px solid #e2dbd2;border-radius:12px;background:#fff;overflow:hidden}.transfer-create summary{padding:1.1rem 1.2rem;cursor:pointer;font-weight:700;color:#5d4932;background:#fbf8f3}.transfer-create-table-wrap{overflow:auto}.transfer-create-table{width:100%;margin:0;border-collapse:collapse}.transfer-create-table th{padding:.85rem;background:#f8f4ee;color:#766b60;font-size:.68rem;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap}.transfer-create-table td{padding:.8rem;border-top:1px solid #ece6de;vertical-align:middle}.transfer-product{display:flex;align-items:center;gap:.8rem;min-width:270px}.transfer-product img{width:48px;height:48px;border-radius:8px;object-fit:cover;background:#f0e9df}.transfer-product strong,.transfer-product small{display:block}.transfer-product small{color:#837a71}.transfer-quantity{width:90px;padding:.55rem .65rem;border:1px solid #d8cec2;border-radius:7px}.transfer-create-actions{display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:end;padding:1rem 1.2rem;border-top:1px solid #e2dbd2;background:#fbf8f3}.transfer-create-actions label{display:block;font-size:.75rem;font-weight:700;color:#6e6258}.transfer-create-actions textarea{display:block;width:100%;min-height:70px;margin-top:.4rem;padding:.65rem;border:1px solid #d8cec2;border-radius:7px}.transfer-button{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:7px;background:#8b6637;color:#fff;padding:.75rem 1rem;font-weight:700;text-decoration:none;cursor:pointer}.transfer-button.secondary{background:#2d261f}.transfer-button.danger{background:#a2483e}.transfer-list{display:grid;gap:1rem}.transfer-card{padding:1.2rem;border:1px solid #e2dbd2;border-radius:12px;background:#fff}.transfer-card-head{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start}.transfer-card-head h3{margin:0;color:#3b332b}.transfer-card-head p{margin:.25rem 0 0;color:#756b62;font-size:.78rem}.transfer-status{display:inline-flex;padding:.35rem .65rem;border-radius:999px;background:#eee8df;color:#6b5c4e;font-size:.72rem;font-weight:700;white-space:nowrap}.transfer-status.in_transit{background:#fff0d9;color:#8a5b16}.transfer-status.received{background:#e8f2e4;color:#4d713f}.transfer-status.cancelled{background:#f3e5e2;color:#9b4439}.transfer-items{display:flex;flex-wrap:wrap;gap:.5rem;margin:1rem 0}.transfer-item{padding:.4rem .65rem;border-radius:7px;background:#f8f4ee;color:#594e44;font-size:.76rem}.transfer-card-footer{display:flex;justify-content:space-between;gap:1rem;align-items:center;padding-top:.9rem;border-top:1px solid #ece6de}.transfer-card-footer small{color:#756b62}.transfer-actions{display:flex;gap:.55rem}.transfer-empty{padding:2rem;text-align:center;border:1px dashed #d9cdbf;border-radius:12px;color:#756b62}@media(max-width:900px){.transfer-tabs{grid-template-columns:1fr 1fr}.transfer-flow{grid-template-columns:1fr}.transfer-flow i{transform:rotate(90deg);text-align:center}.transfer-create-actions{grid-template-columns:1fr}.transfer-card-head,.transfer-card-footer{flex-direction:column}.transfer-card-footer{align-items:flex-start}}@media(max-width:560px){.transfer-tabs{grid-template-columns:1fr}}
    </style>

    {% for type in ['success', 'warning', 'danger'] %}
        {% for message in app.flashes(type) %}<div class="alert alert-{{ type }}">{{ message }}</div>{% endfor %}
    {% endfor %}

    <nav class="transfer-tabs" aria-label="Choisir le pays destinataire">
        {% for market in markets %}
            <a class="transfer-tab {{ selectedMarket and selectedMarket.id == market.id ? 'active' : '' }}" href="{{ path('admin_stock_transfers', {pays: market.countryCode}) }}">
                <div><strong>{{ market.name }}</strong><small>{{ market.currencyCode }}</small></div><span>{{ market.active ? 'Marché actif' : 'Inactif' }}</span>
            </a>
        {% endfor %}
    </nav>

    {% if selectedMarket %}
        {% if not centralWarehouse or not destinationWarehouse %}
            <div class="transfer-notice danger">L’entrepôt central ou le dépôt local de {{ selectedMarket.name }} n’est pas correctement configuré.</div>
        {% else %}
            <section class="transfer-flow">
                <article><strong>{{ centralWarehouse.name }}</strong><small>Stock source · États-Unis</small></article>
                <i class="fa fa-arrow-right" aria-hidden="true"></i>
                <article><strong>{{ destinationWarehouse.name }}</strong><small>Dépôt destinataire · {{ selectedMarket.name }}</small></article>
            </section>

            {% if not selectedMarket.active or not destinationWarehouse.active %}<div class="transfer-notice danger">Ce marché ou son dépôt est désactivé. Aucun nouveau transfert ne peut être préparé.</div>{% endif %}

            <details class="transfer-create" {{ transfers is empty ? 'open' : '' }}>
                <summary>Préparer un nouveau transfert vers {{ selectedMarket.name }}</summary>
                <form method="post">
                    <input type="hidden" name="_token" value="{{ csrf_token('stock-transfer-create-' ~ selectedMarket.id) }}">
                    <input type="hidden" name="_action" value="create">
                    <div class="transfer-create-table-wrap">
                        <table class="transfer-create-table">
                            <thead><tr><th>Produit</th><th>Disponible aux États-Unis</th><th>Disponible localement</th><th>Quantité à transférer</th></tr></thead>
                            <tbody>
                            {% for row in rows %}
                                <tr>
                                    <td><div class="transfer-product"><img src="{{ asset(row.product.imagePath) }}" alt=""><div><strong>{{ row.product.name }}</strong><small>{{ row.product.sku }} · {{ row.product.size }}</small></div></div></td>
                                    <td><strong>{{ row.centralInventory ? row.centralInventory.availableQuantity : 0 }}</strong></td>
                                    <td>{{ row.localInventory ? row.localInventory.availableQuantity : 0 }}</td>
                                    <td><input class="transfer-quantity" type="number" min="0" max="{{ row.centralInventory ? row.centralInventory.availableQuantity : 0 }}" step="1" name="quantities[{{ row.product.id }}]" value="0" aria-label="Quantité de {{ row.product.name }}"></td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="transfer-create-actions"><label>Note logistique facultative<textarea name="notes" maxlength="1000" placeholder="Transporteur, numéro de colis ou consigne…"></textarea></label><button class="transfer-button" type="submit" {{ not selectedMarket.active or not destinationWarehouse.active ? 'disabled' : '' }}>Créer le transfert</button></div>
                </form>
            </details>

            <h2>Historique vers {{ selectedMarket.name }}</h2>
            <section class="transfer-list">
                {% for transfer in transfers %}
                    {% set statusLabels = {draft: 'En préparation', in_transit: 'En transit', received: 'Réceptionné', cancelled: 'Annulé'} %}
                    <article class="transfer-card">
                        <header class="transfer-card-head"><div><h3>{{ transfer.reference }}</h3><p>Créé le {{ transfer.createdAt|date('d/m/Y à H:i') }} · {{ transfer.totalQuantity }} unité{{ transfer.totalQuantity > 1 ? 's' : '' }}</p></div><span class="transfer-status {{ transfer.status }}">{{ statusLabels[transfer.status] }}</span></header>
                        <div class="transfer-items">{% for item in transfer.items %}<span class="transfer-item">{{ item.product.name }} × {{ item.quantity }}</span>{% endfor %}</div>
                        {% if transfer.notes %}<p>{{ transfer.notes }}</p>{% endif %}
                        <footer class="transfer-card-footer">
                            <small>{% if transfer.receivedAt %}Reçu le {{ transfer.receivedAt|date('d/m/Y à H:i') }}{% elseif transfer.shippedAt %}Expédié le {{ transfer.shippedAt|date('d/m/Y à H:i') }}{% else %}Le stock ne sera déduit qu’à la confirmation de l’expédition.{% endif %}</small>
                            <div class="transfer-actions">
                                {% if transfer.status == 'draft' %}
                                    <form method="post"><input type="hidden" name="transfer_id" value="{{ transfer.id }}"><input type="hidden" name="_action" value="cancel"><input type="hidden" name="_token" value="{{ csrf_token('stock-transfer-cancel-' ~ transfer.id) }}"><button class="transfer-button danger" type="submit">Annuler</button></form>
                                    <form method="post"><input type="hidden" name="transfer_id" value="{{ transfer.id }}"><input type="hidden" name="_action" value="ship"><input type="hidden" name="_token" value="{{ csrf_token('stock-transfer-ship-' ~ transfer.id) }}"><button class="transfer-button secondary" type="submit">Confirmer l’expédition</button></form>
                                {% elseif transfer.status == 'in_transit' %}
                                    <form method="post"><input type="hidden" name="transfer_id" value="{{ transfer.id }}"><input type="hidden" name="_action" value="receive"><input type="hidden" name="_token" value="{{ csrf_token('stock-transfer-receive-' ~ transfer.id) }}"><button class="transfer-button" type="submit">Confirmer la réception</button></form>
                                {% endif %}
                            </div>
                        </footer>
                    </article>
                {% else %}
                    <div class="transfer-empty">Aucun transfert n’a encore été préparé pour {{ selectedMarket.name }}.</div>
                {% endfor %}
            </section>
        {% endif %}
    {% endif %}
{% endblock %}
