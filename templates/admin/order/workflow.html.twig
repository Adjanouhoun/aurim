<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ order.reference }} — AURIM</title>
<style>body{margin:0;background:#f6f2eb;color:#33291f;font:15px Arial,sans-serif}.top{background:#211b16;color:#fff;padding:18px 5%;display:flex;justify-content:space-between;align-items:center}.top a{color:#e1c28b;text-decoration:none}.wrap{max-width:1100px;margin:30px auto;padding:0 20px}.head,.card{background:#fff;padding:24px;border:1px solid #e0d5c7;margin-bottom:18px}.eyebrow{color:#9a733f;text-transform:uppercase;letter-spacing:2px;font-size:12px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.row{display:flex;justify-content:space-between;gap:20px;padding:9px 0;border-bottom:1px solid #eee}.items{width:100%;border-collapse:collapse}.items td,.items th{padding:10px;text-align:left;border-bottom:1px solid #eee}.actions{display:flex;gap:10px;flex-wrap:wrap}.actions form{margin:0}.btn{border:0;background:#9a733f;color:#fff;padding:12px 16px;cursor:pointer}.btn.danger{background:#9f4035}.flash{padding:12px;margin-bottom:16px;background:#e7f4e8}.flash.error{background:#f7e5e2}@media(max-width:700px){.grid{grid-template-columns:1fr}.row{display:block}.row strong{display:block;margin-top:5px}}</style></head>
<body><header class="top"><strong>AURIM · Traitement de commande</strong><a href="{{ path('admin') }}">← Administration</a></header><main class="wrap">
{% for message in app.flashes('success') %}<div class="flash">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="flash error">{{ message }}</div>{% endfor %}
<section class="head"><p class="eyebrow">{{ order.reference }}</p><h1>{{ order.customerName }}</h1><p>Statut : <strong>{{ {'pending_payment':'En attente de paiement','paid':'Payée','preparing':'En préparation','shipped':order.fulfillmentType == 'pickup' ? 'Prête au retrait' : 'Expédiée','delivered':order.fulfillmentType == 'pickup' ? 'Remise' : 'Livrée','delivery_failed':'Livraison échouée','payment_failed':'Paiement échoué / annulée','cancelled':'Annulée','refunded':'Remboursée'}[order.status] ?? order.status }}</strong></p></section>
<div class="grid"><section class="card"><h2>Client et réception</h2><div class="row"><span>E-mail</span><strong>{{ order.email }}</strong></div><div class="row"><span>Téléphone</span><strong>{{ order.phone }}</strong></div><div class="row"><span>Mode</span><strong>{{ order.fulfillmentLabel }}</strong></div><div class="row"><span>Adresse client</span><strong>{{ order.addressLine }}</strong></div>{% if order.fulfillmentAddress %}<div class="row"><span>Adresse du dépôt</span><strong>{{ order.fulfillmentAddress }}</strong></div>{% endif %}</section>
<section class="card"><h2>Paiement</h2><div class="row"><span>Moyen</span><strong>{{ order.paymentMethodName }}</strong></div><div class="row"><span>Statut</span><strong>{{ payment ? {'pending':'En attente','received':'Reçu','failed':'Échoué','refunded':'Remboursé'}[payment.status] ?? payment.status : '—' }}</strong></div>{% if payment %}<div class="row"><span>Numéro payeur</span><strong>{{ payment.payerPhone }}</strong></div>{% if payment.externalReference %}<div class="row"><span>Référence opérateur</span><strong>{{ payment.externalReference }}</strong></div>{% endif %}{% endif %}<div class="row"><span>Total</span><strong>{{ order.totalMinor|price(order.currencyCode) }}</strong></div></section></div>
{% if payment and paymentTransitions %}<section class="card"><h2>Actions de paiement</h2><div class="actions">{% for status,label in paymentTransitions %}<form method="post" action="{{ path('admin_payment_transition',{id:payment.id,status:status}) }}" onsubmit="return confirm('Confirmer : {{ label|e('js') }} ?')"><input type="hidden" name="_token" value="{{ csrf_token('payment-transition-'~payment.id~'-'~status) }}">{% if status == 'received' and payment.method.type == 'mobile_money_manual' %}<label style="display:block;margin-bottom:8px">Référence opérateur (facultative)<input name="external_reference" style="display:block;padding:9px;margin-top:5px"></label>{% endif %}<button class="btn {{ status in ['failed','refunded'] ? 'danger' : '' }}">{{ label }}</button></form>{% endfor %}</div></section>{% endif %}
<section class="card"><h2>Produits</h2><table class="items"><thead><tr><th>Produit</th><th>Quantité</th><th>Total</th></tr></thead><tbody>{% for item in order.items %}<tr><td>{{ item.productName }}</td><td>{{ item.quantity }}</td><td>{{ item.totalMinor|price(order.currencyCode) }}</td></tr>{% endfor %}</tbody></table></section>
<section class="card"><h2>Actions disponibles</h2><div class="actions">{% for status,label in transitions %}<form method="post" action="{{ path('admin_order_transition',{id:order.id,status:status}) }}" onsubmit="return confirm('Confirmer : {{ label|e('js') }} ?')"><input type="hidden" name="_token" value="{{ csrf_token('order-transition-'~order.id~'-'~status) }}"><button class="btn {{ status in ['cancelled','delivery_failed'] ? 'danger' : '' }}">{{ label }}</button></form>{% else %}<p>Aucune action logistique disponible pour ce statut.</p>{% endfor %}</div></section>
</main></body></html>
