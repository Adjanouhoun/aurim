<!doctype html>
<html lang="{{ order.locale }}" dir="{{ order.locale == 'ar' ? 'rtl' : 'ltr' }}">
<body style="margin:0;background:#f7f1e8;color:#30251c;font-family:Arial,sans-serif;text-align:{{ order.locale == 'ar' ? 'right' : 'left' }}">
<div style="max-width:640px;margin:0 auto;padding:32px 20px">
    <div style="background:#fffaf3;border:1px solid #dfc89d;padding:32px">
        <p style="margin:0;color:#a4772f;letter-spacing:3px;font-size:13px">AURIM · GLOWING BY RIMA</p>
        <h1 style="font-family:Georgia,serif;font-weight:400">{{ 'email.payment.title'|trans }}</h1>
        <p>{{ 'email.common.hello'|trans({'%name%': order.customerName}) }}</p>
        <p>{{ 'email.payment.received'|trans }} <strong>{{ payment.amountMinor|price(payment.currencyCode) }}</strong> {{ 'email.payment.via'|trans }} <strong>{{ payment.method.localizedName(order.locale) }}</strong>.</p>
        <p><strong>{{ 'email.payment.order_reference'|trans }} :</strong> {{ order.reference }}</p>
        <p><strong>{{ 'email.payment.payer_phone'|trans }} :</strong> {{ payment.payerPhone }}</p>
        {% if payment.externalReference %}<p><strong>{{ 'email.payment.operator_reference'|trans }} :</strong> {{ payment.externalReference }}</p>{% endif %}
        <p>{{ 'email.payment.next'|trans }}</p>
        <p style="font-size:13px;color:#74675c">{{ 'email.common.thanks'|trans }}<br>{{ 'email.common.team'|trans }}</p>
    </div>
</div>
</body>
</html>
