<!doctype html>
<html lang="fr">
<body style="margin:0;background:#f7f1e8;color:#30251c;font-family:Arial,sans-serif">
<div style="max-width:640px;margin:0 auto;padding:32px 20px">
    <div style="background:#fffaf3;border:1px solid #dfc89d;padding:32px">
        <p style="margin:0;color:#a4772f;letter-spacing:3px;font-size:13px">AURIM · GLOWING BY RIMA</p>
        <h1 style="font-family:Georgia,serif;font-weight:400">{{ title }}</h1>
        <p>Bonjour {{ order.customerName }},</p>
        <p>{{ message }}</p>
        <p><strong>Référence :</strong> {{ order.reference }}</p>
        {% if order.fulfillmentType == 'pickup' and order.fulfillmentAddress %}
            <p><strong>Adresse du dépôt :</strong><br>{{ order.fulfillmentAddress }}</p>
        {% elseif order.fulfillmentType == 'delivery' %}
            <p><strong>Adresse de livraison :</strong><br>{{ order.addressLine }}</p>
        {% endif %}
        <p style="font-size:13px;color:#74675c">Merci pour votre confiance.<br>L’équipe AURIM</p>
    </div>
</div>
</body>
</html>
