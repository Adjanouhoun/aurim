<!doctype html>
<html lang="fr">
<body style="margin:0;background:#f5f0e8;color:#302820;font-family:Arial,sans-serif">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f5f0e8;padding:28px 12px"><tr><td align="center">
    <table role="presentation" width="620" cellspacing="0" cellpadding="0" style="max-width:620px;background:#fff;border-radius:14px;overflow:hidden">
        <tr><td style="padding:26px 30px;background:#2d261f;color:#fff"><div style="font-family:Georgia,serif;font-size:26px;letter-spacing:3px">AURIM</div><div style="margin-top:6px;color:#ddc9ab;font-size:13px">Alerte logistique</div></td></tr>
        <tr><td style="padding:30px">
            <h1 style="margin:0 0 12px;font-family:Georgia,serif;font-size:28px">Stock faible détecté</h1>
            <p style="margin:0 0 22px;color:#6e6359;line-height:1.6">{{ movements|length }} produit{{ movements|length > 1 ? 's ont' : ' a' }} franchi le seuil d’alerte dans {{ countries|join(', ') }}.</p>
            {% for movement in movements %}
                <div style="margin:0 0 12px;padding:16px;border:1px solid #e7ded2;border-radius:10px">
                    <strong style="display:block;font-size:16px">{{ movement.product.name }}</strong>
                    <span style="display:block;margin-top:5px;color:#7a6e63">{{ movement.warehouse.name }} · {{ movement.balanceOnHand - movement.balanceReserved }} disponible{{ movement.balanceOnHand - movement.balanceReserved > 1 ? 's' : '' }}</span>
                    <small style="display:block;margin-top:5px;color:#9a733f">Référence : {{ movement.reference ?? 'correction manuelle' }}</small>
                </div>
            {% endfor %}
            <p style="margin:24px 0 0"><a href="{{ alertsUrl }}" style="display:inline-block;margin-right:8px;padding:12px 16px;border-radius:7px;background:#8b6637;color:#fff;text-decoration:none;font-weight:bold">Voir les stocks à surveiller</a><a href="{{ journalUrl }}" style="display:inline-block;padding:12px 16px;color:#6f512b;font-weight:bold">Ouvrir le journal</a></p>
        </td></tr>
    </table>
</td></tr></table>
</body>
</html>
