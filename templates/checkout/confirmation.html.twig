{% extends 'base.html.twig' %}
{% block title %}Commande {{ order.reference }} — AURIM{% endblock %}
{% block body %}
{% include '_header.html.twig' %}
<main class="order-confirmation"><p class="eyebrow">{{ 'confirmation.eyebrow'|trans }}</p><h1>{{ 'confirmation.thanks'|trans({'%name%': order.customerName}) }}</h1><p>{{ 'confirmation.reference'|trans }} <strong>{{ order.reference }}</strong>.</p><p>{{ 'confirmation.fulfillment'|trans }} : <strong>{{ order.fulfillmentLabel }}</strong>{% if order.fulfillmentAddress %}<br>{{ order.fulfillmentAddress }}{% endif %}</p><div><span>{{ 'confirmation.subtotal'|trans }}</span><strong>{{ price_formatter.format(order.subtotalMinor, order.currencyCode) }}</strong></div><div><span>{{ 'confirmation.shipping'|trans }}</span><strong>{{ price_formatter.format(order.shippingMinor, order.currencyCode) }}</strong></div><div><span>{{ 'confirmation.total'|trans }}</span><strong>{{ price_formatter.format(order.totalMinor, order.currencyCode) }}</strong></div>{% if payment %}<section class="manual-payment">{% if payment.method.type == 'cash' %}<p class="eyebrow">{{ 'confirmation.cash.eyebrow'|trans }}</p><h2>{{ payment.method.localizedName(app.request.locale) }}</h2><p>{{ 'confirmation.cash.amount'|trans }} <strong>{{ price_formatter.format(payment.amountMinor, payment.currencyCode) }}</strong>.</p>{% if payment.method.localizedInstructions(app.request.locale) %}<p>{{ payment.method.localizedInstructions(app.request.locale) }}</p>{% endif %}<p>{{ 'confirmation.cash.reference'|trans }} <strong>{{ order.reference }}</strong>.</p>{% else %}<p class="eyebrow">{{ 'confirmation.mobile.eyebrow'|trans }}</p><h2>{{ payment.method.localizedName(app.request.locale) }}</h2><p>{{ 'confirmation.mobile.send'|trans }} <strong>{{ price_formatter.format(payment.amountMinor, payment.currencyCode) }}</strong> {{ 'confirmation.mobile.to_number'|trans }}</p><strong class="payment-number">{{ payment.method.recipientAccount ?: 'confirmation.mobile.number_later'|trans }}</strong>{% if payment.method.accountHolder %}<p>{{ 'confirmation.mobile.holder'|trans }} : {{ payment.method.accountHolder }}</p>{% endif %}{% if payment.method.localizedInstructions(app.request.locale) %}<p>{{ payment.method.localizedInstructions(app.request.locale) }}</p>{% endif %}<p>{{ 'confirmation.mobile.payer'|trans({'%phone%': payment.payerPhone}) }} {{ 'confirmation.mobile.validation'|trans }}</p>{% endif %}</section>{% endif %}<a class="button" href="{{ path('app_home') }}">{{ 'confirmation.home'|trans }}</a></main>
<p class="confirmation-tracking"><a href="{{ path('app_order_tracking') }}">{{ 'confirmation.tracking'|trans }}</a></p>
{% include '_footer.html.twig' %}
{% endblock %}
