{% extends 'base.html.twig' %}
{% block title %}Commande {{ order.reference }} — AURIM{% endblock %}
{% block body %}
{% include '_header.html.twig' %}
<main class="order-confirmation"><p class="eyebrow">Commande enregistrée</p><h1>Merci, {{ order.customerName }}.</h1><p>Votre référence est <strong>{{ order.reference }}</strong>.</p><p>Mode de réception : <strong>{{ order.fulfillmentLabel }}</strong>{% if order.fulfillmentAddress %}<br>{{ order.fulfillmentAddress }}{% endif %}</p><div><span>Sous-total</span><strong>{{ price_formatter.format(order.subtotalMinor, order.currencyCode) }}</strong></div><div><span>Frais de réception</span><strong>{{ price_formatter.format(order.shippingMinor, order.currencyCode) }}</strong></div><div><span>Total à payer</span><strong>{{ price_formatter.format(order.totalMinor, order.currencyCode) }}</strong></div>{% if payment %}<section class="manual-payment">{% if payment.method.type == 'cash' %}<p class="eyebrow">Paiement au dépôt</p><h2>{{ payment.method.name }}</h2><p>Montant à régler lors du retrait : <strong>{{ price_formatter.format(payment.amountMinor, payment.currencyCode) }}</strong>.</p>{% if payment.method.instructions %}<p>{{ payment.method.instructions }}</p>{% endif %}<p>Présentez votre référence <strong>{{ order.reference }}</strong> lors du retrait.</p>{% else %}<p class="eyebrow">Paiement Mobile Money</p><h2>{{ payment.method.name }}</h2><p>Envoyez exactement <strong>{{ price_formatter.format(payment.amountMinor, payment.currencyCode) }}</strong> au numéro :</p><strong class="payment-number">{{ payment.method.recipientAccount ?: 'Numéro à communiquer par AURIM' }}</strong>{% if payment.method.accountHolder %}<p>Titulaire : {{ payment.method.accountHolder }}</p>{% endif %}{% if payment.method.instructions %}<p>{{ payment.method.instructions }}</p>{% endif %}<p>Utilisez le numéro payeur <strong>{{ payment.payerPhone }}</strong>. AURIM validera manuellement la commande après réception du paiement.</p>{% endif %}</section>{% endif %}<a class="button" href="{{ path('app_home') }}">Retour à l’accueil</a></main>
<p><a href="{{ path('app_order_tracking') }}">Suivre l’avancement de ma commande</a></p>
{% include '_footer.html.twig' %}
{% endblock %}
