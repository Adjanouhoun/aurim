{% extends 'base.html.twig' %}
{% block title %}{{ 'checkout.meta_title'|trans }}{% endblock %}
{% block body %}
{% include '_header.html.twig' %}
<main class="checkout-page">
    <div class="checkout-heading"><p class="eyebrow">{{ 'checkout.eyebrow'|trans }}</p><h1>{{ 'checkout.title'|trans }}</h1><p>{{ 'checkout.local_delivery'|trans({'%market%': ('market.' ~ market.countryCode)|trans}) }}</p></div>
    {% if shippingRates is empty %}<div class="checkout-alert">{{ 'checkout.no_shipping'|trans }}</div>{% endif %}
    {% if errors %}<div id="checkout-errors" class="checkout-errors" role="alert" tabindex="-1"><strong>{{ 'checkout.errors.title'|trans }}</strong><ul>{% for error in errors %}<li>{{ error|trans }}</li>{% endfor %}</ul></div>{% endif %}
    <div class="checkout-layout">
        <form class="checkout-form" method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('checkout') }}">
            <label>{{ 'checkout.full_name'|trans }}<input name="name" value="{{ app.request.request.get('name') }}" required></label>
            <div class="form-row"><label>{{ 'checkout.email'|trans }}<input type="email" name="email" value="{{ app.request.request.get('email') }}" required></label><label><span id="phone-label">{{ 'checkout.phone'|trans }}</span><input type="tel" name="phone" value="{{ app.request.request.get('phone') }}" required aria-describedby="payment-phone-help"></label></div>
            <fieldset class="fulfillment-options">
                <legend>{{ 'checkout.fulfillment.legend'|trans }}</legend>
                {% for type, title in {'pickup': 'checkout.fulfillment.pickup', 'delivery': 'checkout.fulfillment.delivery'} %}
                    {% set typeRates = shippingRates|filter(rate => rate.fulfillmentType == type) %}
                    {% if typeRates is not empty %}
                        <h2>{{ title|trans }}</h2>
                        {% for rate in typeRates %}
                            <label class="fulfillment-card">
                                <input type="radio" name="shipping_rate" value="{{ rate.id }}" data-fulfillment="{{ type }}" data-shipping="{{ price_formatter.format(rate.amountMinor, market.currencyCode) }}" data-total="{{ price_formatter.format(subtotal + rate.amountMinor, market.currencyCode) }}" {{ app.request.request.get('shipping_rate') == rate.id ? 'checked' : '' }} required>
                                <span><strong>{{ rate.localizedLabel(app.request.locale) }}</strong><small>{{ rate.city }} · {{ 'checkout.days'|trans({'%min%': rate.minimumDays, '%max%': rate.maximumDays}) }}</small>{% if rate.addressLine %}<small class="pickup-address">{{ rate.addressLine }}</small>{% endif %}</span>
                                <b>{{ rate.amountMinor == 0 ? 'checkout.free'|trans : price_formatter.format(rate.amountMinor, market.currencyCode) }}</b>
                            </label>
                        {% endfor %}
                    {% endif %}
                {% endfor %}
            </fieldset>
            <fieldset class="fulfillment-options payment-options">
                <legend>{{ 'checkout.payment.legend'|trans }}</legend>
                <p id="payment-choice-help" class="payment-guidance">{{ 'checkout.payment.choose_fulfillment'|trans }}</p>
                {% for method in paymentMethods %}
                    <label class="fulfillment-card payment-card" data-scope="{{ method.fulfillmentScope }}" data-payment-type="{{ method.type }}">
                        <input type="radio" name="payment_method" value="{{ method.id }}" {{ app.request.request.get('payment_method') == method.id ? 'checked' : '' }} required>
                        <span><strong>{{ method.localizedName(app.request.locale) }}</strong>{% if method.localizedInstructions(app.request.locale) %}<small>{{ method.localizedInstructions(app.request.locale) }}</small>{% endif %}</span>
                        <b>{{ (method.type == 'cash' ? 'checkout.payment.cash' : (method.type == 'mobile_money_manual' ? 'checkout.payment.mobile' : 'checkout.payment.online'))|trans }}</b>
                    </label>
                {% else %}
                    <div class="checkout-alert">{{ 'checkout.payment.none_country'|trans }}</div>
                {% endfor %}
                <div id="payment-unavailable" class="checkout-alert" hidden>{{ 'checkout.payment.none_fulfillment'|trans }}</div>
                <div id="payment-phone-help" class="payment-phone-help" hidden>
                    <strong>{{ 'checkout.payment.phone_help_title'|trans }}</strong>
                    <span>{{ 'checkout.payment.phone_help_text'|trans }}</span>
                </div>
            </fieldset>
            <label>{{ 'checkout.address'|trans }}<textarea name="address" rows="4" required>{{ app.request.request.get('address') }}</textarea></label>
            <button id="checkout-submit" class="button" type="submit" disabled>{{ 'checkout.submit'|trans }}</button>
        </form>
        <aside class="checkout-summary"><p class="eyebrow">{{ 'checkout.summary.title'|trans }}</p>{% for line in lines %}<div class="checkout-line"><span>{{ line.product.localizedName(app.request.locale) }} × {{ line.quantity }}</span><strong>{{ price_formatter.format(line.lineTotal, market.currencyCode) }}</strong></div>{% endfor %}<div class="checkout-line"><span>{{ 'checkout.summary.subtotal'|trans }}</span><strong>{{ price_formatter.format(subtotal, market.currencyCode) }}</strong></div><div class="checkout-line"><span>{{ 'checkout.summary.fulfillment'|trans }}</span><strong id="shipping-amount">{{ 'checkout.summary.select'|trans }}</strong></div><div class="checkout-total"><span>{{ 'checkout.summary.total'|trans }}</span><strong id="order-total">—</strong></div><p>{{ 'checkout.summary.note'|trans }}</p></aside>
    </div>
</main>
<script>
const checkoutErrors = document.getElementById('checkout-errors');
if (checkoutErrors) {
    checkoutErrors.scrollIntoView({behavior: 'smooth', block: 'center'});
    checkoutErrors.focus({preventScroll: true});
}
const paymentCards = document.querySelectorAll('.payment-card');
const paymentChoiceHelp = document.getElementById('payment-choice-help');
const paymentPhoneHelp = document.getElementById('payment-phone-help');
const paymentUnavailable = document.getElementById('payment-unavailable');
const phoneLabel = document.getElementById('phone-label');
const checkoutSubmit = document.getElementById('checkout-submit');
const phoneLabels = {{ {'default': 'checkout.phone'|trans, 'mobile': 'checkout.mobile_phone'|trans}|json_encode|raw }};

const updatePaymentPhoneHelp = () => {
    const selectedPayment = document.querySelector('input[name="payment_method"]:checked');
    const isMobileMoney = selectedPayment?.closest('.payment-card')?.dataset.paymentType === 'mobile_money_manual';
    paymentPhoneHelp.hidden = !isMobileMoney;
    phoneLabel.textContent = isMobileMoney ? phoneLabels.mobile : phoneLabels.default;
};

paymentCards.forEach((card) => {
    card.querySelector('input').addEventListener('change', updatePaymentPhoneHelp);
});

document.querySelectorAll('input[name="shipping_rate"]').forEach((input) => {
    const update = () => {
        document.getElementById('shipping-amount').textContent = input.dataset.shipping;
        document.getElementById('order-total').textContent = input.dataset.total;
        paymentChoiceHelp.hidden = true;
        let visiblePaymentCount = 0;
        paymentCards.forEach((card) => {
            const visible = card.dataset.scope === 'both' || card.dataset.scope === input.dataset.fulfillment;
            card.hidden = !visible;
            if (!visible) card.querySelector('input').checked = false;
            if (visible) visiblePaymentCount++;
        });
        paymentUnavailable.hidden = visiblePaymentCount > 0;
        checkoutSubmit.disabled = visiblePaymentCount === 0;
        updatePaymentPhoneHelp();
    };
    input.addEventListener('change', update);
    if (input.checked) update();
});

if (!document.querySelector('input[name="shipping_rate"]:checked')) {
    paymentCards.forEach((card) => card.hidden = true);
    checkoutSubmit.disabled = true;
}
updatePaymentPhoneHelp();
</script>
{% include '_footer.html.twig' %}
{% endblock %}
