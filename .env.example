# Copiez ce fichier vers .env.local puis remplacez uniquement les valeurs locales.
# Ne publiez jamais de mots de passe ou de clés réelles dans Git.

APP_ENV=dev
APP_SECRET=change-me-in-env-local
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost:8000

DATABASE_URL="postgresql://app:change-me@127.0.0.1:54320/app?serverVersion=16&charset=utf8"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

MAILER_DSN=null://null
AURIM_EMAIL_FROM=contact@example.com
AURIM_EMAIL_ADMIN=contact@example.com

# Informations obligatoires des pages légales. Remplacez chaque valeur avant la mise en ligne.
AURIM_LEGAL_COMPANY_NAME=AURIM
AURIM_LEGAL_FORM="À renseigner"
AURIM_LEGAL_REGISTRATION="À renseigner"
AURIM_LEGAL_ADDRESS="À renseigner"
AURIM_LEGAL_EMAIL=contact@amadouadjanouhoun.fr
AURIM_LEGAL_PHONE="À renseigner"
AURIM_LEGAL_PUBLICATION_DIRECTOR="À renseigner"
AURIM_LEGAL_HOST_NAME="À renseigner"
AURIM_LEGAL_HOST_ADDRESS="À renseigner"
